# Copied to .env by `make env`, which also generates POSTGRES_PASSWORD. Nothing secret is committed.

# demo: generates its own token secret and demo users at startup (shared by all replicas through the database).
# production: refuses to start without AUTH_SECRET (>= 32 bytes) and a real model provider.
APP_MODE=demo
# AUTH_SECRET=

# fake = deterministic stand-in (no key; runs the same graph). Real providers, each with its own standard variables:
#   anthropic     ANTHROPIC_API_KEY                                   LLM_MODEL=claude-opus-5-5 (default)
#   openai        OPENAI_API_KEY  (+ LLM_BASE_URL for any OpenAI-compatible gateway)   LLM_MODEL=<model>
#   azure_openai  AZURE_OPENAI_API_KEY, AZURE_OPENAI_ENDPOINT, OPENAI_API_VERSION      LLM_MODEL=<deployment>
#   google_genai  GOOGLE_API_KEY                                                       LLM_MODEL=<gemini model>
#   bedrock       AWS_REGION + the AWS credential chain                                LLM_MODEL=<bedrock model id>
#   ollama        LLM_BASE_URL=http://host.docker.internal:11434                       LLM_MODEL=<local model>
LLM_PROVIDER=fake
# LLM_MODEL=claude-opus-5-5
# PRICE_PER_MTOK_IN=5  PRICE_PER_MTOK_OUT=25   # for the cost metric: set from your price list
# ANTHROPIC_API_KEY=
# LLM_BASE_URL=

# Seconds a turn waits for an operator to approve a write action before answering "pending".
HITL_SYNC_WAIT_S=10

# Optional: also post every new human case to a Microsoft Teams channel (incoming webhook URL).
# TEAMS_WEBHOOK_URL=

POSTGRES_PASSWORD=
